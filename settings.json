{
    // Clangd configuration
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/niu/build",
        "--query-driver=D:/zephyr-sdk-0.17.4/*/bin/*",
        "--background-index",
        "--clang-tidy"
    ],
    
    // Terminal auto-activation
    // 自动查找 west 所在的虚拟环境并激活，无需硬编码路径
    "python.terminal.activateEnvironment": true,
    "terminal.integrated.env.windows": {
        "WORKSPACE_ROOT": "${workspaceFolder}"
    },
    "terminal.integrated.profiles.windows": {
        "PowerShell (west-venv)": {
            "source": "PowerShell",
            "args": [
                "-NoExit",
                "-Command",
                "$ok=$false;",
                "$local=\"$env:WORKSPACE_ROOT\\.venv\\Scripts\\Activate.ps1\";",
                "if(Test-Path $local){ & $local; $ok=$true }",
                "else {",
                "  foreach($w in (Get-Command -All west -EA SilentlyContinue)){",
                "    $a=Join-Path (Split-Path $w.Source) 'Activate.ps1';",
                "    if(Test-Path $a){& $a; $ok=$true; break}",
                "  }",
                "};",
                "if(-not $ok){Write-Host 'No west venv found, skipping activation' -ForegroundColor Yellow};",
                "Set-Location \"$env:WORKSPACE_ROOT\""
            ]
        }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell (west-venv)"
}
